FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
# Modèle de tri (EXE-99) — trie toutes les offres ; gemma4:12b (OLLAMA_MODEL,
# modèle de précision) ne relit que celles classées parfait/rêve ou illisibles.
OLLAMA_MODEL_TRI=llama3
# Seconde passe par lots (EXE-100) — gemma tourne par lots de
# SECOND_PASS_BATCH_SIZE offres (défaut 10), avec une pause de
# SECOND_PASS_PAUSE_SECONDS entre deux lots (défaut 300 = 5 min), jusqu'à
# SECOND_PASS_MAX_BATCHES lots par run (défaut 5).
SECOND_PASS_BATCH_SIZE=10
SECOND_PASS_PAUSE_SECONDS=300
SECOND_PASS_MAX_BATCHES=5
